{
  "Serilog": {
    "MinimumLevel": "Information",
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/plasma-docker-.log",
          "restrictedToMinimumLevel": "Information",
          "rollingInterval": "Hour",
          "flushToDiskInterval": "00:05:00"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Docker": {
  }
}
